# Environment jembatan webhook ERP -> receiver core (contoh; salin ke .env)
# URL receiver — pilih sesuai posisi ERP:
#   same machine : http://127.0.0.1:3000/api/webhooks/wms
#   VPC privat   : http://10.3.0.14:3000/api/webhooks/wms
#   publik       : http://43.159.42.38:3000/api/webhooks/wms  (belum aktif)
OSR_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/wms
OSR_WEBHOOK_TOKEN=changeme
OSR_MODE=baseline
